class Solution 
{
    String binaryNextNumber(String s) 
    {
        StringBuilder sb=new StringBuilder();
        int c=1;
        int t=0;
        while(t<s.length() && s.charAt(t)=='0')t++;
        if(t==s.length())return "1";
        String str=s.substring(t);
        int n=str.length();
        for(int i=0;i<n;i++)
        {
            int sum=(str.charAt(n-i-1)-'0')+c;
            if(sum==2)
            {
                sb.append(0);
                c=1;
            }
            else
            {
                sb.append(sum);
                c=0;
            }
        }
        if(c!=0)sb.append(c);
        return sb.reverse().toString();
    }
}
